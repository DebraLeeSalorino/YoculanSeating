# Postgres connection string
DATABASE_URL=postgres://yoculan:yoculan@localhost:5432/yoculan
# Public address of the app, used in emailed links
APP_URL=http://localhost:3000
# "log" writes emails to the console and mail-log/ (default until SES is set up)
MAIL_TRANSPORT=log
MAIL_FROM="Yoculan Tickets <tickets@example.org>"
# Square: "sandbox" or "production". Leave unset to run without Square.
SQUARE_ENVIRONMENT=
# Square access token. Keep it in the host's secret settings, never in the repository.
SQUARE_ACCESS_TOKEN=
# From Square's webhook subscription, once the app is online.
SQUARE_WEBHOOK_SIGNATURE_KEY=
